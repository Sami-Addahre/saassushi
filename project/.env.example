# Telegram
BOT_TOKEN=your_telegram_bot_token

# Google Calendar (Service Account)
# 1. Crea un progetto su https://console.cloud.google.com
# 2. Abilita Google Calendar API
# 3. Crea un Service Account e scarica credentials.json
# 4. Condividi il calendario con l'email del service account
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Ristorante
RESTAURANT_NAME=Sushi Zen
RESTAURANT_ADDRESS=Via Roma 12, Rovereto
TIMEZONE=Europe/Rome
DEPOSIT_EUR=10
